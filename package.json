{
  "name": "cabo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @cabo/shared && npm run build -w @cabo/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev:server": "npm run dev -w @cabo/server",
    "dev:mobile": "npm run start -w @cabo/mobile",
    "db:generate": "npm run db:generate -w @cabo/server",
    "db:migrate": "npm run db:migrate -w @cabo/server",
    "railway": "node scripts/railway-command.mjs",
    "test:release": "node --test apps/mobile/scripts/release-config.check.cjs",
    "verify:live": "node scripts/verify-live.mjs",
    "benchmark:bots": "node --import tsx scripts/benchmark-bots.ts",
    "verify:bots-live": "node scripts/verify-bots-live.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "vitest": "4.1.12",
    "@types/node": "^22.19.0",
    "railway": "3.16.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "glob": "^14.0.4",
    "minimatch": "^11.0.7",
    "esbuild": "^0.28.2",
    "tinypool": "^2.1.2"
  }
}
