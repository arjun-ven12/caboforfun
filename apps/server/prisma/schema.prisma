generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
 directUrl = env("DIRECT_DATABASE_URL")
}
model User {
 id String @id
 name String
 email String @unique
 emailVerified Boolean @default(false)
 image String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sessions Session[]
 accounts Account[]
 profile Profile?
 memberships RoomMember[]
 notifications Notification[]
 pushTokens PushToken[]
 presets RulePreset[]
 outgoing SocialEdge[] @relation("SocialFrom")
 incoming SocialEdge[] @relation("SocialTo")
 hostedRooms Room[]
 sentInvites Invitation[] @relation("InviteFrom")
 receivedInvites Invitation[] @relation("InviteTo")
}
model Session {
 id String @id
 expiresAt DateTime
 token String @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 ipAddress String?
 userAgent String?
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId])
}
model Account {
 id String @id
 accountId String
 providerId String
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 accessToken String?
 refreshToken String?
 idToken String?
 accessTokenExpiresAt DateTime?
 refreshTokenExpiresAt DateTime?
 scope String?
 password String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId])
 @@unique([providerId,accountId])
}
model Verification {
 id String @id
 identifier String
 value String
 expiresAt DateTime
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([identifier])
}
model Profile {
 userId String @id
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 username String @unique
 displayName String
 presenceVisible Boolean @default(true)
 lastSeen DateTime @default(now())
 online Boolean @default(false)
}
model SocialEdge {
 id String @id @default(cuid())
 fromId String
 from User @relation("SocialFrom",fields:[fromId],references:[id],onDelete:Cascade)
 toId String
 to User @relation("SocialTo",fields:[toId],references:[id],onDelete:Cascade)
 kind String
 createdAt DateTime @default(now())
 @@unique([fromId,toId,kind])
 @@index([toId,kind])
}
model Room {
 id String @id @default(cuid())
 code String @unique
 hostId String?
 host User? @relation(fields:[hostId],references:[id],onDelete:SetNull)
 status String @default("lobby")
 rules Json
 createdAt DateTime @default(now())
 members RoomMember[]
 invitations Invitation[]
 matches Match[]
 activeMatchId String?
}
model RoomMember {
 id String @id @default(cuid())
 roomId String
 room Room @relation(fields:[roomId],references:[id],onDelete:Cascade)
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 seat Int
 ready Boolean @default(false)
 connectedAt DateTime?
 disconnectedAt DateTime?
 rematch Boolean @default(false)
 @@unique([roomId,userId])
 @@unique([roomId,seat])
 @@index([userId])
}
model Invitation {
 id String @id @default(cuid())
 tokenHash String @unique
 roomId String
 room Room @relation(fields:[roomId],references:[id],onDelete:Cascade)
 fromId String
 from User @relation("InviteFrom",fields:[fromId],references:[id],onDelete:Cascade)
 toId String?
 to User? @relation("InviteTo",fields:[toId],references:[id],onDelete:Cascade)
 expiresAt DateTime
 revoked Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([toId,expiresAt])
}
model Match {
 id String @id @default(cuid())
 roomId String
 room Room @relation(fields:[roomId],references:[id])
 rules Json
 previousId String?
 createdAt DateTime @default(now())
 completedAt DateTime?
 snapshot GameSnapshot?
 actions GameAction[]
 participants MatchParticipant[]
 rounds Round[]
 @@index([roomId,createdAt])
}
model MatchParticipant {
 id String @id @default(cuid())
 matchId String
 match Match @relation(fields:[matchId],references:[id],onDelete:Cascade)
 userId String
 total Int @default(0)
 winner Boolean @default(false)
 @@unique([matchId,userId])
 @@index([userId,matchId])
}
model Round {
 id String @id @default(cuid())
 matchId String
 match Match @relation(fields:[matchId],references:[id],onDelete:Cascade)
 number Int
 scores Json
 @@unique([matchId,number])
}
// Confidential: NEVER serialize this model through a generic REST endpoint.
model GameSnapshot {
 matchId String @id
 match Match @relation(fields:[matchId],references:[id],onDelete:Cascade)
 version Int
 state Json
 updatedAt DateTime @updatedAt
}
model GameAction {
 id String @id @default(cuid())
 matchId String
 match Match @relation(fields:[matchId],references:[id],onDelete:Cascade)
 userId String
 actionId String
 version Int
 type String
 createdAt DateTime @default(now())
 @@unique([userId,actionId])
 @@index([matchId,version])
}
model RulePreset {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 name String
 versions RuleVersion[]
 createdAt DateTime @default(now())
 @@index([userId])
}
model RuleVersion {
 id String @id @default(cuid())
 presetId String
 preset RulePreset @relation(fields:[presetId],references:[id],onDelete:Cascade)
 rules Json
 createdAt DateTime @default(now())
}
model Notification {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 kind String
 body String
 roomId String?
 read Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}
model PushToken {
 token String @id
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId])
}
