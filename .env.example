NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://cabo:cabo@localhost:5432/cabo
DIRECT_DATABASE_URL=postgresql://cabo:cabo@localhost:5432/cabo
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
APP_DOMAIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:8081
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000
EXPO_PUBLIC_APP_DOMAIN=https://YOUR_APP_DOMAIN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CABO <hello@YOUR_APP_DOMAIN>
IOS_APP_ID=TEAM_ID.com.caboforfun.app
ANDROID_SHA256_FINGERPRINTS=
ANDROID_PACKAGE=com.caboforfun.app
IOS_STORE_URL=
ANDROID_STORE_URL=
